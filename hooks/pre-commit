#!/bin/sh
# Git runs pre-commit from the working-tree root and supplies the active index.
# python3 may be an older system interpreter, so try versioned names before giving up.
for python in python3 python3.14 python3.13 python3.12 python3.11; do
  if command -v "$python" >/dev/null 2>&1 &&
    "$python" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
    exec "$python" -B tools/check_staged.py
  fi
done
echo "Maintainer Skills Lab: staged check needs Python 3.11 or newer on PATH." >&2
exit 1
